# Copy to .env.local and fill in. Never commit real values — .env* is git-ignored.

# Production origin, used for canonical URLs, Open Graph tags and sitemap.xml
NEXT_PUBLIC_SITE_URL=https://jointalero.com

# Resend (https://resend.com) — required in production to deliver form submissions
RESEND_API_KEY=
# Sender address on a domain verified in Resend
EMAIL_FROM=Jointalero <website@jointalero.com>
